# ── Suno API (required for music generation) ──────────────────────────────
# Get your key at: https://sunoapi.org/api-key
SUNO_API_KEY=your_suno_api_key_here

# ── Pexels (required for background videos) ──────────────────────────────
# Free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── YouTube OAuth (required for upload) ──────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com/
# Download credentials.json and place it in the project root
# token.json will be auto-generated on first run

# ── OpenRouter (optional — for AI descriptions) ───────────────────────────
# Free tier available at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Defaults ──────────────────────────────────────────────────────────────
DEFAULT_GENRE=lofi_hiphop
DEFAULT_MODEL=V4_5ALL
VIDEOS_PER_DAY=3
AUTO_UPLOAD=true
